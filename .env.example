# Copy this file to ".env" and fill in the values. The server reads .env ONCE
# at startup - after any change here you must stop it and run "npm start"
# again, or the old values stay in effect.

# --- Database (required) ---------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Student_Helper2_DB

# --- Session (required) ----------------------------------------------------
# Sign-in cookies are signed with this. Anyone who knows it can forge a
# session for ANY account, admin included, so it must not be a value that has
# ever appeared in a repository or a tutorial. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

PORT=3002

# --- Where uploaded files are kept -----------------------------------------
#   disk       (default) public/uploads/ - correct on your own machine or a
#              VPS, where the disk is really yours and survives a restart.
#   database   the bytes go into the database, split into 1 MiB chunks.
#              Slower, but the ONLY thing that works on a host with a
#              throwaway filesystem - which is every free tier: Koyeb free,
#              Vercel, Render free. Without it, uploads vanish on the next
#              deploy and the app reports files it can no longer find.
FILE_STORAGE=disk

# Sessions are kept in the database by default, so a restart does not sign
# everyone out. Set to "memory" only to fall back to in-process sessions.
SESSION_STORE=

# --- Hosted database (TLS) -------------------------------------------------
# Managed MySQL providers (TiDB Cloud, PlanetScale, Aiven, Hostinger remote
# MySQL) all require an encrypted connection, and mysql2 does not enable TLS
# on its own - without this the connection is refused with a confusing
# handshake error. Leave both unset for MySQL on your own machine.
#
#   DB_SSL=true          verify against the system CA store (TiDB Cloud,
#                        PlanetScale and Aiven all work with just this)
#   DB_SSL_CA=./ca.pem   verify against a CA file your provider gave you
DB_SSL=
DB_SSL_CA=

# --- Gemini AI (optional) --------------------------------------------------
# Without this, the quiz / flashcards / summary / study-buddy features report
# that they are switched off. Everything else works normally.
# Get a key at https://aistudio.google.com/apikey
# Both formats are valid: the older "AIza..." keys and the "AQ.Ab..." keys
# AI Studio issues now.
# Check it end to end with:  npm run ai:check
GEMINI_API_KEY=

# Optional. The app defaults to gemini-3.7-flash. Note the DOTS in the id -
# "gemini-3-7-flash" appears in Google's doc URLs but is not a valid model
# parameter. Google retires model IDs on a schedule; if the default stops
# working the app falls back to a live model and logs which one to put here.
# "npm run ai:check" lists the models your key can use.
# GEMINI_MODEL=gemini-3.7-flash

# Optional, Gemini 3.x only: how much the model deliberates before answering.
# low | medium | high. This app defaults to "low" - nothing it asks for needs
# deep reasoning, and at Google's "medium" default a plain chat question was
# slow enough to come back as 504 DEADLINE_EXCEEDED.
# GEMINI_THINKING_LEVEL=low

# Optional. How long a request may take, in milliseconds (default 120000).
#
# IMPORTANT: this is not only a local timeout. The SDK sends it to Google as
# an X-Server-Timeout header, so it is also the deadline GOOGLE works to.
# Setting it too low makes Google give up and return
#   504 DEADLINE_EXCEEDED - "Deadline expired before operation could complete"
# even though the key and the network are perfectly fine. Raise it for large
# PDFs; do not lower it to "fail faster".
# GEMINI_TIMEOUT_MS=120000

# --- When Google is busy ----------------------------------------------------
# A 503 "this model is currently experiencing high demand" is Google's
# capacity, not a fault here - and the newest model attracts the most of it.
# The app sets an overloaded model aside for a few minutes and asks an
# alternate instead, so a busy model does not take the assistant down.
#
# Alternates are discovered from your own key's model list. To choose them
# yourself (most preferred first):
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash
#
# How many models to try per question. Each attempt costs one request from the
# daily allowance, so this is deliberately small.
# GEMINI_MODEL_ATTEMPTS=2
#
# How long to leave an overloaded model alone, in milliseconds (default 3 min).
# GEMINI_CONGESTION_HOLD_MS=180000

# Optional. How many times to retry a transient failure (504/503/408).
# Quota errors (429) are never retried - each retry would spend another
# request from an allowance that is already gone.
# GEMINI_RETRY_ATTEMPTS=3

# --- Free-tier quota -------------------------------------------------------
# Free Gemini keys allow only a small number of requests PER DAY (this
# project's key reported 20/day for gemini-3.7-flash). See your own limits at
# https://ai.dev/rate-limit
#
# To make that go further the app: never retries a quota error, caches the
# dashboard's recommendations, and stops calling Google once the allowance is
# spent. If you need more, pick a model with a larger free allowance
# (npm run ai:check lists what your key can use) or enable billing.
#
# How long to reuse the dashboard's recommendations, in milliseconds
# (default 6 hours). They are identical for every visit, so this is the
# difference between a few requests a day and one per page load.
# GEMINI_RECOMMEND_TTL_MS=21600000

# Optional. Send Gemini requests somewhere other than Google - an API gateway
# or a corporate relay. Leave unset to use the real endpoint.
# GEMINI_BASE_URL=https://gateway.example.com

# --- Behind a proxy? -------------------------------------------------------
# Node's fetch does NOT use the system proxy settings, so on a university or
# company network the browser can reach Google while the server cannot - the
# symptom is "could not reach Google" with the internet plainly working.
# If your network needs a proxy, set it here AND run:  npm install undici
# HTTPS_PROXY=http://proxy.your-university.edu:8080

# If antivirus or a company proxy inspects HTTPS, Node will reject its
# certificate even though your browser accepts it. Point Node at that root
# certificate rather than turning verification off:
# NODE_EXTRA_CA_CERTS=C:\path\to\corporate-root.crt
#
# Diagnose either of the above with:  npm run ai:net

# --- Sign in with Google (optional) ----------------------------------------
# Leave these blank and the "Sign in with Google" button is hidden; username
# and password sign-in is unaffected.
#
# To enable it:
#   1. https://console.cloud.google.com/  ->  create (or pick) a project
#   2. "APIs & Services" -> "OAuth consent screen" -> configure it
#      (External; add yourself under "Test users" while it is unpublished, or
#      nobody else will be able to sign in)
#   3. "APIs & Services" -> "Credentials" -> "Create credentials"
#      -> "OAuth client ID" -> Application type: "Web application"
#   4. Under "Authorised redirect URIs" add EXACTLY the callback below -
#      Google matches it character for character, including the port:
#         http://localhost:3002/auth/google/callback
#   5. Copy the client ID and client secret into the two lines below
#   6. Restart the server
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if the app is not on http://localhost:<PORT> - e.g. in
# production. Must match a redirect URI registered in step 4 exactly.
# GOOGLE_CALLBACK_URL=https://your-domain.example/auth/google/callback

# --- Optional tuning -------------------------------------------------------
# CORS_ORIGIN=https://your-frontend.example
# RATE_LIMIT_MAX=1200
# AUTH_RATE_LIMIT_MAX=5
# AI_RATE_LIMIT_MAX=30
